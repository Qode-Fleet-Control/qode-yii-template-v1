#!/usr/bin/env bash
#
# stop — stop the running app. Used by bin/restart and bin/reload; also useful
# standalone. Prefers the pidfile written by run / start, and falls back to
# freeing whatever is listening on $PORT.
#
# When the app is managed by the fleet, prefer the dashboard's "■ stop app"
# button; this is the CLI equivalent.
# fleet.conf's commands are written relative to the REPO ROOT, so run them from
# there — not from bin/, where this script lives. _common.sh resolves FLEET_ROOT
# from its own location, so it is sourced by path before the cd.
. "$(dirname "$0")/_common.sh"
cd "$FLEET_ROOT"

stop_running
